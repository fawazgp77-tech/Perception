<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MobilityAssist" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/olive_dark</item>
        <item name="android:colorAccent">@color/olive_mid</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:buttonStyle">@style/PerceptionButton.Primary</item>
    </style>
    <style name="PerceptionButton" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:textColor">@color/cream</item>
    </style>
    <style name="PerceptionButton.Primary">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/cream</item>
    </style>
    <style name="PerceptionButton.Secondary" />
    <style name="PerceptionButton.Scanner">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@color/cream</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="ScannerChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/cream</item>
    </style>
</resources>
