<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- App title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/screen_title"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:padding="16dp" />

    <!-- Camera preview + detection overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <com.example.mobilityassist.OverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

    </FrameLayout>

    <!-- Primary obstacle warning status (18sp, white, always visible) -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/starting_detector"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="12dp" />

    <!-- TTS engine status (amber, accessibility live region) -->
    <TextView
        android:id="@+id/speechStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/starting_speech"
        android:textColor="#FFE082"
        android:paddingHorizontal="12dp"
        android:accessibilityLiveRegion="polite" />

    <!-- Phase 3: compact status row — lighting | angle | camera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:importantForAccessibility="yes">

        <TextView
            android:id="@+id/lightingStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#80CBC4"
            android:gravity="center"
            android:text="@string/status_lighting_normal" />

        <TextView
            android:id="@+id/angleStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#B0BEC5"
            android:gravity="center"
            android:text="@string/status_angle_unavailable" />

        <TextView
            android:id="@+id/cameraStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#B0BEC5"
            android:gravity="center"
            android:text="@string/status_camera_unavailable" />

    </LinearLayout>

    <!-- Rolling pipeline diagnostics (hidden from TalkBack) -->
    <TextView
        android:id="@+id/diagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#B0BEC5"
        android:paddingHorizontal="12dp"
        android:importantForAccessibility="no" />

    <!-- Safety disclaimer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/size_note"
        android:textColor="#FFFFFF"
        android:padding="12dp" />

    <!-- Pause / resume / retry button -->
    <Button
        android:id="@+id/toggle"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/pause_assistance" />

</LinearLayout>
