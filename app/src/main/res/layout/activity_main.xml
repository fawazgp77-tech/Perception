<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/menuPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_title"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:paddingBottom="20dp" />

        <CheckBox
            android:id="@+id/speechToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_speech"
            android:checked="true"
            android:minHeight="56dp" />

        <TextView
            android:id="@+id/menuSpeechStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/starting_speech"
            android:textColor="#FFE082"
            android:accessibilityLiveRegion="polite"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/startAssistance"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/start_assistance" />

        <Button
            android:id="@+id/startDepthAssistance"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/start_depth_assistance" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/map_navigation_title"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:paddingTop="24dp" />

        <EditText
            android:id="@+id/destinationInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/destination_hint"
            android:inputType="textPostalAddress"
            android:importantForAutofill="no"
            android:singleLine="true"
            android:minHeight="56dp" />

        <Button
            android:id="@+id/speakDestination"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/speak_destination" />

        <Button
            android:id="@+id/previewWalkingRoute"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/preview_walking_route" />

        <Button
            android:id="@+id/saveHome"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/save_home" />

        <Button
            android:id="@+id/navigateHome"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/navigate_home" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/map_handoff_note"
            android:textColor="#FFFFFF"
            android:paddingTop="16dp" />
    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/scannerPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

    <!-- App title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/screen_title"
        android:textSize="22sp"
        android:textColor="#FFFFFF"
        android:padding="16dp" />

    <!-- Camera preview + detection overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <com.example.mobilityassist.OverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

    </FrameLayout>

    <!-- Primary obstacle warning status (18sp, white, always visible) -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/starting_detector"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:padding="12dp" />

    <!-- TTS engine status (amber, accessibility live region) -->
    <TextView
        android:id="@+id/speechStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/starting_speech"
        android:textColor="#FFE082"
        android:paddingHorizontal="12dp"
        android:accessibilityLiveRegion="polite" />

    <!-- Phase 3: compact status row — lighting | angle | camera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:importantForAccessibility="yes">

        <TextView
            android:id="@+id/lightingStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#80CBC4"
            android:gravity="center"
            android:text="@string/status_lighting_normal" />

        <TextView
            android:id="@+id/angleStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#B0BEC5"
            android:gravity="center"
            android:text="@string/status_angle_unavailable" />

        <TextView
            android:id="@+id/cameraStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#B0BEC5"
            android:gravity="center"
            android:text="@string/status_camera_unavailable" />

    </LinearLayout>

    <!-- Rolling pipeline diagnostics (hidden from TalkBack) -->
    <TextView
        android:id="@+id/diagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#B0BEC5"
        android:paddingHorizontal="12dp"
        android:importantForAccessibility="no" />

    <!-- Safety disclaimer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/size_note"
        android:textColor="#FFFFFF"
        android:padding="12dp" />

    <!-- Pause / resume / retry button -->
    <Button
        android:id="@+id/toggle"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/pause_assistance" />

    <Button
        android:id="@+id/backToMenu"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/back_to_menu" />

    </LinearLayout>
</FrameLayout>
